{
  "name": "supply-chain-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Supply Chain Provenance on Hyperledger Fabric",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/verifyAuthenticityTest.js",
    "test:ledger": "node test/ledgerVerificationTest.js",
    "test:custody": "node test/ownershipTransferTest.js",
